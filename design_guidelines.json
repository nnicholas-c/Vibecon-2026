{
  "project_name": "Drivepast - Phase 1",
  "tagline": "Every van gets an agent that sells its own empty minutes.",
  "client_business": "Bayline Courier",
  "owner_name": "Arthur Pendelton",
  "design_archetype": "Calm, professional dispatch software",
  "typography": {
    "font_family_body": "Inter, system-ui, -apple-system, sans-serif",
    "font_family_heading": "Plus Jakarta Sans, Inter, system-ui, sans-serif",
    "font_variant_numeric": "tabular-nums",
    "letter_spacing_headings": "tracking-tight",
    "heading_h1": "text-2xl font-bold tracking-tight text-slate-900",
    "heading_h2": "text-xl font-semibold tracking-tight text-slate-900",
    "heading_h3": "text-lg font-semibold text-slate-900",
    "body_text": "text-sm text-slate-700 leading-relaxed",
    "caption_text": "text-xs text-slate-500",
    "time_format": "h:mm a (e.g., '1:50pm')"
  },
  "colors": {
    "background_main": "#F8FAFC",
    "surface_card": "#FFFFFF",
    "surface_border": "#E2E8F0",
    "text_primary": "#0F172A",
    "text_secondary": "#64748B",
    "text_muted": "#94A3B8",
