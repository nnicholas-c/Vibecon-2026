  "layout_strategy": {
    "desktop_breakpoint": "768px",
    "desktop_panes": {
      "left_rail": {
        "width": "260px",
        "bg": "#FFFFFF",
        "border": "border-r border-slate-200",
        "sections": [
          "Header (Business switcher: Bayline Courier, 6 active vans)",
          "Dispatch Pinned Row with Fleet icon",
          "FLEET AGENTS (6 unit rows with color dots, names, nicknames, 'N stops, M spare min')",
          "Inbox badge (count: 3)",
          "Phones row",
          "Settings row (pinned at bottom)",
          "Fictional Owner Watermark: Arthur Pendelton (Owner)"
        ]
      },
      "center_pane": {
        "width": "340px",
        "bg": "#F8FAFC",
        "border": "border-r border-slate-200",
        "sections": [
          "Echo Agent Chat header",
          "Transcript message thread with timestamps ('1:50pm')",
          "3 Suggested prompts chips ('Sell 30 spare min on Van 101', 'Check Van 103 capacity', 'Show today\\'s total revenue')",
          "Interactive chat prompt input with submit"
        ]
      },
      "right_pane": {
        "flex": "flex-1",
        "bg": "#F8FAFC",
        "sections": [
          "Unit Page OR Dispatch Page OR Settings Page OR Inbox/Phones Placeholder"
        ]
      }
    },
    "mobile_layout": {
      "tab_bar": "3 Tabs: ['List', 'Chat', 'Page']",
      "list_tab": "Left rail fleet list & settings links",
      "chat_tab": "Center echo chat experience",
      "page_tab": "Active Unit / Dispatch / Settings page content"
    }
  },
  "page_specifications": {
    "unit_page": {
      "header_card": {
        "fields": ["Van Name", "Nickname", "Driver Name & Avatar", "Stops Today Count", "Spare Minutes Left Badge", "Live Agent Status Pill"]
      },
      "timeline_card": {
        "title": "Today's Schedule & Delivery Windows",
        "item_fields": ["Arrival Time (e.g., 1:50pm)", "Customer Name", "Street Address", "Time Window Badge (e.g., 1:30pm - 2:15pm)", "Stop Type (Pickup / Delivery / Agent-Sold Stop)"]
      },
      "stats_row": {
        "metrics": [
          {"label": "Cost per Stop", "data_testid": "unit-stat-cost-per-stop", "format": "$8.20/stop"},
          {"label": "Revenue per Day", "data_testid": "unit-stat-revenue-per-day", "format": "$420.00/day"},
          {"label": "On-time Rate (4 wks)", "data_testid": "unit-stat-ontime-rate", "format": "98.4%"}
        ]
      }
    },
    "dispatch_page": {
      "header_summary": {
        "total_vans": 6,
        "total_spare_min": 210,
        "daily_revenue": "$2,840.00"
      },
      "fleet_table": {
        "data_testid": "dispatch-units-table",
        "columns": [
          "Van & Nickname",
          "Driver",
          "Stops",
          "Spare Min",
          "Revenue / Day",
          "Cost / Stop",
          "Agent Status",
          "Actions"
        ]
      }
    },
    "settings_page": {
      "fields": [
        {"id": "base-hourly-rate", "label": "Base Driver Hourly Rate ($)", "type": "number", "default": 24.50},
        {"id": "fuel-surcharge", "label": "Fuel Cost Surcharge ($/mile)", "type": "number", "default": 0.65},
        {"id": "extra-stop-fee", "label": "Minimum Fee per New Stop ($)", "type": "number", "default": 18.00},
        {"id": "travel-speed", "label": "Average Travel Speed (mph)", "type": "number", "default": 22},
        {"id": "minutes-per-stop", "label": "Minutes Allocated per New Stop", "type": "number", "default": 15},
        {"id": "auto-send-toggle", "label": "Auto-send Agent Deals", "type": "switch", "default": true},
        {"id": "demo-date", "label": "Demo Date (Read-only)", "type": "input", "readOnly": true, "default": "Oct 14, 2026"},
        {"id": "demo-clock", "label": "Demo Clock (Editable)", "type": "input", "default": "1:50pm"},
        {"id": "real-texting-toggle", "label": "Real Texting Mode", "type": "switch", "default": false, "subtext": "Off (Simulated local network)"},
        {"id": "text-channel", "label": "SMS Channel", "type": "select", "default": "Twilio Sandbox (Demo)"},
        {"id": "team-numbers", "label": "Team Phone Numbers List", "type": "list", "default": ["+1 (555) 019-2831 (Dispatch)", "+1 (555) 012-8843 (Dave - Van 101)"]},
        {"id": "business-type", "label": "Business Type", "type": "input", "readOnly": true, "default": "Courier"}
      ],
      "connection_status_rows": [
        {"name": "Our Model", "status": "Not set up yet", "badge": "grey", "note": "using fallback"},
        {"name": "Backup AI", "status": "Emergent universal key", "badge": "green", "note": "Active"},
        {"name": "OpenStreetMap Data", "status": "Connected", "badge": "green", "note": "Routing operational"},
        {"name": "Real Texting", "status": "Disabled", "badge": "amber", "note": "Demo mode active"}
      ],
      "demo_controls": {
        "reset_demo_button": {
          "label": "Reset demo data",
          "enabled": true,
          "data_testid": "reset-demo-data-button",
          "requires_confirmation": true
        },
        "disabled_buttons": [
          {"label": "Import external CSV", "tooltip": "Available in a later step"},
          {"label": "Clear route history", "tooltip": "Available in a later step"},
          {"label": "Sync Telematics", "tooltip": "Available in a later step"}
        ]
      }
    },
    "inbox_page": {
      "data_testid": "inbox-page",
      "placeholder_title": "Courier Agent Inbox",
      "placeholder_message": "All customer inquiries and automated ETA notifications are processed automatically by your 6 van agents. No manual intervention needed right now."
    },
    "phones_page": {
      "data_testid": "phones-page",
      "placeholder_title": "Dispatch VoIP & Phone Center",
      "placeholder_message": "Line active: +1 (555) 019-2831. Automatic SMS text channels are online for all 6 vans."
    }
  },
