      },
      {
        "id": "van_103",
        "name": "Van 103",
        "hex": "#D97706",
        "bg_soft": "#FFFBEB",
        "label": "Amber Ochre"
      },
      {
        "id": "van_104",
        "name": "Van 104",
        "hex": "#7C3AED",
        "bg_soft": "#F5F3FF",
        "label": "Royal Violet"
      },
      {
        "id": "van_105",
        "name": "Van 105",
